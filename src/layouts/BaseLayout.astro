---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { resolveImage } from "../lib/images.js";

const {
  title = "Urdu Ai Impact",
  description = "Public impact hub for Urdu Ai's AI literacy work across Pakistan.",
  canonical,
  simpleNav = false,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  ogImage = "/assets/urdu-ai-logo-og.png"
} = Astro.props;

const site = Astro.site ?? new URL("https://impact.urduai.org");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
// A "/assets/..." share image that now lives in src/assets is rendered to a stable
// 1200px JPEG (social crawlers do not all accept WebP); anything else passes through.
const ogMeta = resolveImage(ogImage);
const ogRendered = ogMeta ? await getImage({ src: ogMeta, width: 1200, format: "jpg", quality: 80 }) : null;
const ogImageUrl = new URL(ogRendered?.src ?? ogImage, site).href;
const ogImageWidth = ogRendered?.attributes?.width ?? 1200;
const ogImageHeight = ogRendered?.attributes?.height ?? 630;

// Site-wide entity graph. Page templates add their own WebPage / Article nodes and
// reference the organisation by its @id.
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "NGO"],
      "@id": "https://urduai.org/#organization",
      "name": "Urdu Ai",
      "alternateName": ["Urdu AI", "اردو اے آئی"],
      "url": "https://urduai.org/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://impact.urduai.org/assets/urdu-ai-logo-og.png",
        "width": 2058,
        "height": 1156
      },
      "description":
        "Pakistan's first Urdu-language AI literacy platform. Urdu Ai trains local facilitators (Dosts) who deliver community AI education in Urdu across schools, universities, vocational centres and public institutions.",
      "email": "ai@urduai.org",
      "areaServed": { "@type": "Country", "name": "Pakistan" },
      "knowsLanguage": ["ur", "en"],
      "parentOrganization": {
        "@type": "NGO",
        "name": "WANG",
        "url": "https://wang.org.pk/"
      },
      "sameAs": [
        "https://www.facebook.com/urduaiorg",
        "https://www.instagram.com/urduaiorg/",
        "https://x.com/urduaiorg",
        "https://www.tiktok.com/@urduaiorg",
        "https://www.linkedin.com/company/urduaiorg/",
        "https://www.youtube.com/playlist?list=PLcj1P8Ql0CihyALOpajIbj_yquUC6NlXI"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://impact.urduai.org/#website",
      "url": "https://impact.urduai.org/",
      "name": "Urdu Ai Impact",
      "description": "Public impact hub for Urdu Ai's AI literacy work across Pakistan: reported reach, Dost network, institutional partnerships and field notes.",
      "inLanguage": "en",
      "publisher": { "@id": "https://urduai.org/#organization" }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    {simpleNav && <meta name="referrer" content="no-referrer" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Urdu Ai Impact Program" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="sitemap" href="https://impact.urduai.org/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#2e549a" />
    <link rel="preload" href="/fonts/montserrat-latin-wght-v31.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container nav">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true"><span>Urdu</span><span>Ai</span></span>
            <span class="brand-word">Impact</span>
          </a>
          {!simpleNav && <nav class="nav-links" aria-label="Primary">
            <a href="/#numbers">Numbers</a>
            <a href="/#map">Atlas</a>
            <a href="/#model">Model</a>
            <a href="/#dosts">Dosts</a>
            <a href="/#stories">Stories</a>
            <a href="/impact-notes/">Impact Notes</a>
            <a href="/institutional-partnerships/">MoUs</a>
            <a href="/#team">Team</a>
            <a href="/#recognition">Recognition</a>
            <a href="/#partner">Partner</a>
            <a href="/contact/">Contact</a>
          </nav>}
          <a class="button secondary" href="/#learn">Learn Now</a>
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>
