---
import BaseLayout from "../layouts/BaseLayout.astro";
import { impactNotes } from "../data/impactNotes.js";

// Astro writes this to dist/404.html; Cloudflare Pages serves it with a real 404 status
// for any unknown path, instead of falling back to the homepage with 200.
const latestNotes = [...impactNotes]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout
  title="Page not found | Urdu Ai Impact"
  description="The page you were looking for is not on the Urdu Ai Impact site. Find the impact numbers, Dost atlas, partnerships and field notes from here."
  robots="noindex, follow"
>
  <main>
    <section class="section not-found">
      <div class="container not-found-panel">
        <div>
          <span class="eyebrow">404</span>
          <h1>This page is not here.</h1>
          <p class="urdu-line">یہ صفحہ موجود نہیں ہے۔ نیچے دیے گئے لنکس سے آگے بڑھیں۔</p>
          <p>
            The link may be old, or the address may have a typo. Everything public about Urdu Ai's AI literacy work is reachable from the links below.
          </p>
          <div class="hero-actions">
            <a class="button" href="/">Back to the impact home</a>
            <a class="button secondary" href="/impact-notes/">Read impact notes</a>
          </div>
        </div>
        <nav class="not-found-links" aria-label="Main sections">
          <h2>Go to</h2>
          <ul>
            <li><a href="/#numbers">Reported numbers</a></li>
            <li><a href="/#map">Dost district atlas</a></li>
            <li><a href="/institutional-partnerships/">Institutional partnerships and MoUs</a></li>
            <li><a href="/#team">Team</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="https://urduai.org/">Urdu Ai learning platform (urduai.org)</a></li>
          </ul>
          <h2>Latest impact notes</h2>
          <ul>
            {latestNotes.map((note) => (
              <li><a href={`/impact-notes/${note.slug}/`}>{note.title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
  }

  .not-found-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 40px;
    align-items: start;
  }

  .not-found h1 {
    margin: 0 0 12px;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 850;
  }

  .not-found .eyebrow {
    color: var(--teal);
  }

  .not-found-links {
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .not-found-links h2 {
    margin: 0 0 10px;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .not-found-links h2 + ul + h2 {
    margin-top: 22px;
  }

  .not-found-links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .not-found-links a {
    font-weight: 700;
    text-decoration: none;
    color: var(--teal);
  }

  .not-found-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .not-found-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
