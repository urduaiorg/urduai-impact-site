---
import BaseLayout from "../layouts/BaseLayout.astro";
import { institutionalPartners, institutionalEvidence } from "../data/institutions.js";
import { stats } from "../data/impact.js";

const pageTitle = "Institutional Partnerships & MoUs | Urdu Ai Impact";
const pageDescription =
  "Urdu Ai institutional partnerships and MoUs with national nonprofit organizations, universities, women-focused institutes, technical and vocational partners, and regional education centers advancing community AI education, digital literacy, and future-ready skills in Pakistan.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://impact.urduai.org/institutional-partnerships/",
      "url": "https://impact.urduai.org/institutional-partnerships/",
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "name": "Urdu Ai Impact",
        "url": "https://impact.urduai.org/"
      },
      "about": [
        "community AI education in Pakistan",
        "AI literacy partnerships",
        "national nonprofit AI education partnerships",
        "digital skills for youth and women",
        "institutional MoUs for future-ready skills"
      ],
      "mentions": [
        {
          "@type": "NGO",
          "name": "Alkhidmat Foundation Pakistan",
          "url": "https://alkhidmat.org/"
        }
      ]
    },
    {
      "@type": "EducationalOrganization",
      "name": "Urdu Ai",
      "url": "https://urduai.org/",
      "areaServed": "Pakistan",
      "knowsAbout": [
        "AI literacy",
        "digital literacy",
        "community education",
        "Urdu-language AI learning",
        "future-ready skills"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why do institutional MoUs matter for community AI education?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Institutional MoUs give Urdu Ai trusted entry points inside universities, technical centers, and local education systems. They make learner access, scheduling, practical training, and follow-up easier to organize."
          }
        },
        {
          "@type": "Question",
          "name": "Who benefits from Urdu Ai institutional partnerships?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Students, women learners, faculty, vocational trainees, regional youth, and community facilitators benefit through Urdu-first AI literacy, digital skills, practical tool use, and future-ready employability pathways."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of partners can support Urdu Ai?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Supporters, universities, vocational institutes, public-sector education bodies, foundations, CSR teams, and AI access programs can support training cohorts, women-led pathways, teacher enablement, district learning, and public impact updates."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://impact.urduai.org/institutional-partnerships/"
  ogImage="/assets/institutions/government-sadiq-women-university-bahawalpur-mou.jpg"
>
  <main>
    <section class="partnership-hero">
      <div class="container partnership-hero-grid">
        <div class="partnership-hero-copy">
          <span class="eyebrow">Institutional partnerships and MoUs</span>
          <h1>MoUs help grow Urdu Ai as a trusted community AI education movement across Pakistan.</h1>
          <p class="partnership-lede">
            Urdu Ai is building one of Pakistan's largest Urdu-first community AI education movements through national nonprofit partners, trusted universities, women-focused institutions, technical training centers, and regional education networks.
          </p>
          <p class="partnership-urdu urdu-line">تعلیمی اداروں کے ساتھ شراکت داری سے اے آئی سیکھنا زیادہ قابل اعتماد، مقامی اور قابل پیمائش بنتا ہے۔</p>
          <div class="partnership-actions">
            <a class="button" href="#mou-photos">View MoU photos</a>
            <a class="button secondary" href="#why-partners-care">Why this matters</a>
          </div>
        </div>
        <div class="partnership-hero-card partnership-hero-card--text" aria-label="MoU partnership summary">
          <strong>MoU network</strong>
          <span>National nonprofit, university, technical, and regional education partners</span>
          <p>Formal agreements help Urdu Ai schedule training, support learners, and grow trusted AI literacy pathways beyond one-off events.</p>
        </div>
      </div>
    </section>

    <section class="section partnership-photo-section" id="mou-photos" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2>MoU photo slideshow.</h2>
          <p class="section-lede">
            These photos show institutional trust: national nonprofit organizations, universities, technical centers, and local education partners formally opening pathways for AI literacy, digital skills, and applied learning.
          </p>
        </div>

        <div class="mou-slider" aria-label="Urdu Ai institutional MoU photo slideshow">
          {institutionalPartners.map((partner, index) => (
            <figure class="mou-slide" id={`mou-${index + 1}`}>
              <img src={partner.image} alt={`MoU between Urdu Ai and ${partner.institution} in ${partner.place}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption>
                <span>{partner.place}</span>
                <strong>{partner.institution}</strong>
                <p>{partner.focus}</p>
                {partner.url && <a class="partner-reference" href={partner.url}>View partner</a>}
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="mou-dots" aria-label="MoU slide navigation">
          {institutionalPartners.map((partner, index) => (
            <a href={`#mou-${index + 1}`} aria-label={`Show ${partner.institution} MoU`}></a>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt national-mou-section" data-reveal>
      <div class="container national-mou-grid">
        <figure>
          <img src="/assets/institutions/alkhidmat-foundation-pakistan-mou.jpg" alt="National-level MoU between Alkhidmat Foundation Pakistan and Urdu Ai at Head Office Lahore" loading="lazy" decoding="async" />
        </figure>
        <div>
          <span class="eyebrow">National-level MoU</span>
          <h2>Alkhidmat Foundation Pakistan and Urdu Ai are opening a larger pathway for AI education and digital inclusion.</h2>
          <p>
            Urdu Ai has signed a national-level MoU with Alkhidmat Foundation Pakistan at its Head Office in Lahore. Alkhidmat is one of Pakistan's leading nonprofit humanitarian organizations, serving vulnerable communities since 1990 through education, healthcare, disaster response, orphan care, clean water, skills development, microfinance, and community services.
          </p>
          <p>
            Through this partnership, Urdu Ai aims to bring practical AI education and digital skills to small and medium-sized enterprises, persons with disabilities, educational institutions, service-sector professionals, nonprofit organizations, young people, teachers, and underserved communities across Pakistan.
          </p>
          <p>
            By combining Alkhidmat's nationwide community network with Urdu Ai's accessible Urdu-language AI education, the partnership can help more Pakistanis use artificial intelligence for learning, employment, entrepreneurship, productivity, and social impact.
          </p>
          <div class="national-mou-actions">
            <a class="button" href="/contact/">Discuss partnership</a>
            <a class="button secondary" href="https://alkhidmat.org/">View Alkhidmat</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt" id="why-partners-care" data-reveal>
      <div class="container funder-case-grid">
        <div class="funder-case-copy">
          <span class="eyebrow">Why partners support this</span>
          <h2>Strong AI education programs need trusted places where people can learn and continue practicing.</h2>
          <p>
            Urdu Ai's institutional MoUs create reliable pathways for women, youth, students, vocational learners, service-sector professionals, persons with disabilities, SMEs, and underserved communities through trusted local institutions, Urdu-first learning, practical digital skills, and partner-supported follow-up.
          </p>
          <p>
            Urdu Ai's institutional partnerships support AI literacy, digital inclusion, teacher enablement, youth employability, vocational skills, responsible AI use, nonprofit capacity, entrepreneurship, and community-led learning across Pakistan.
          </p>
        </div>
        <div class="funder-keywords" aria-label="Partner and search-friendly themes">
          <span>Community AI education</span>
          <span>AI literacy in Pakistan</span>
          <span>Digital skills for youth</span>
          <span>Women and girls in AI</span>
          <span>Responsible AI learning</span>
          <span>Vocational AI skills</span>
          <span>AI for nonprofit and humanitarian work</span>
          <span>AI skills for SMEs and PWDs</span>
          <span>Future-ready skills</span>
          <span>Education technology for inclusion</span>
          <span>AI for underserved communities</span>
          <span>South Asia digital inclusion</span>
        </div>
      </div>
    </section>

    <section class="section partnership-card-section" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2>Partner network.</h2>
          <p class="section-lede">
            The MoU network now combines a national humanitarian nonprofit partner, women-focused universities, regional universities, and technical-vocational education, giving Urdu Ai a stronger path from awareness to applied skills.
          </p>
        </div>
        <div class="partnership-card-grid">
          {institutionalPartners.map((partner) => (
            <article class="partnership-card">
              <img src={partner.image} alt={`${partner.institution} MoU with Urdu Ai`} loading="lazy" decoding="async" />
              <div>
                <span>{partner.place}</span>
                <h3>{partner.institution}</h3>
                <p>{partner.focus}</p>
                {partner.url && <a class="partner-reference" href={partner.url}>View partner</a>}
                <dl>
                  <div>
                    <dt>Audience</dt>
                    <dd>{partner.audience}</dd>
                  </div>
                  <div>
                    <dt>Partner type</dt>
                    <dd>{partner.type}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt" data-reveal>
      <div class="container partnership-proof-layout">
        <article class="partnership-proof-panel">
          <span class="eyebrow">How MoUs help delivery</span>
          <h2>From public awareness to structured AI learning pathways.</h2>
          <ul>
            <li>Institutions provide trusted venues where learners already gather.</li>
            <li>National nonprofit partners can connect AI learning with humanitarian, livelihood, inclusion, and community service networks.</li>
            <li>Faculty and administrators help organize cohorts and follow-up.</li>
            <li>Women-focused and regional partners reduce access barriers.</li>
            <li>Vocational partners connect AI learning with employability and technical skills.</li>
            <li>MoU photos and partner records show where local learning pathways are being built.</li>
          </ul>
        </article>
        <div class="institution-photo-grid">
          {institutionalEvidence.map((item) => (
            <figure>
              <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section answer-section" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2>Answers for partners, supporters, and AI education programs.</h2>
          <p class="section-lede">
            Short answers are included for people and AI search systems looking for community AI literacy programs in Pakistan, South Asia, and emerging markets.
          </p>
        </div>
        <div class="answer-grid">
          <article>
            <h3>What is Urdu Ai?</h3>
            <p>
              Urdu Ai is an Urdu-first AI literacy movement helping students, teachers, women, workers, freelancers, and community leaders understand and use artificial intelligence in practical ways.
            </p>
          </article>
          <article>
            <h3>Why is this important in Pakistan?</h3>
            <p>
              Many learners are blocked by English-first training, urban access gaps, and low confidence with new tools. Urdu Ai lowers the first barrier through local language learning and trusted community delivery.
            </p>
          </article>
          <article>
            <h3>How do MoUs help?</h3>
            <p>
              MoUs convert interest into repeatable delivery: scheduled cohorts, partner venues, student access, community access, faculty engagement, nonprofit networks, follow-up, and long-term institutional trust.
            </p>
          </article>
          <article>
            <h3>What can partners support?</h3>
            <p>
              Partners can support women-led AI learning cohorts, vocational AI skills, teacher training, district facilitators, AI skills for SMEs and PWDs, public-interest AI curricula, learner stories, and regional expansion.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section partnership-cta-section" data-reveal>
      <div class="container partnership-cta">
        <div>
          <span class="eyebrow">Partner with Urdu Ai</span>
          <h2>Support community AI education that trusted institutions can host.</h2>
          <p>
            Urdu Ai has documented {stats[0].value} learners trained, an estimated {stats[1].value} average-size trainings based on 25-30 participants per session, {stats[2].value} women participation, and institutional relationships across Pakistan. The next step is deeper, better-supported AI learning pathways.
          </p>
        </div>
        <a class="button" href="mailto:ai@urduai.org?subject=Urdu Ai institutional partnership">Discuss partnership</a>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>
    const revealItems = document.querySelectorAll("[data-reveal]");
    document.documentElement.classList.add("js-ready");

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.16 }
      );

      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }
  </script>
</BaseLayout>
